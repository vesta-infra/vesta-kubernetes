# Local development environment for the Vesta API.
# Copy to api/.env (gitignored) and adjust. `make run-api` sources it automatically.

# Required. The API refuses to start without these.
DATABASE_URL=postgres://vesta:vesta-dev@localhost:5433/vesta?sslmode=disable
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random

# Optional.
PORT=8090
# Base URL used to build links in outbound email. Never taken from request headers.
VESTA_PUBLIC_URL=http://localhost:3000
# Comma-separated proxy CIDRs whose X-Forwarded-For may be trusted. Empty trusts none.
VESTA_TRUSTED_PROXIES=
# Extra origins allowed to open log/exec WebSockets, beyond same-origin requests.
# The Vite dev server proxies /api, so same-origin already covers local development.
VESTA_ALLOWED_ORIGINS=

# Encrypts reversible secrets at rest -- currently TOTP shared secrets. 32 raw bytes,
# base64-encoded: openssl rand -base64 32
# Optional. Without it, authenticator-app 2FA is unavailable; passkeys still work.
VESTA_ENCRYPTION_KEY=
